# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 运行时数据（本地单机跑的 SQLite 文件）
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 环境变量与密钥
.env
.env.*

# 日志
logs/
*.log

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/

# 运行时工作区（每次 run 的隔离调查目录）
workspaces/

# CI 配置暂不上传（当前 GitHub Token 缺 workflow 权限；获得后取消此行并提交该文件）
.github/workflows/ci.yml
